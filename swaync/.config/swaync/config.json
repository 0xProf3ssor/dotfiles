{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 450,
  "control-center-height": 650,
  "notification-window-width": 450,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "actions": [
        {
          "label": "\uf1eb",
          "command": "swaync-client -t; foot -a nmtui -W 80x24 -e ~/.local/bin/nmtui"
        },
        {
          "label": "\uf294",
          "command": "swaync-client -t; foot -a bluetui -W 100x30 -e bluetui"
        },
        {
          "label": "\uf1f6",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && swaync-client -dn || swaync-client -df'",
          "type": "toggle",
          "update-command": "swaync-client -D"
        },
        {
          "label": "\uf011",
          "command": "swaync-client -t; ~/.local/bin/wlogout-toggle"
        }
      ],
      "buttons-per-row": 4
    },
    "dnd": {
      "text": "Notifications"
    },
    "volume": {
      "label": "\udb81\udd7e"
    },
    "backlight": {
      "label": "\udb80\udcdf"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 0
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "notifications": {
      "vexpand": true
    }
  }
}